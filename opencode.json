{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "small_model": "opencode/ling-3.0-flash-free",
  "share": "disabled",
  "default_agent": "build",
  "provider": {
    "opencode": {
      "options": {}
    }
  },
  "mcp": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "enabled": false,
      "args": ["-y", "@upstash/context7-mcp"]
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  }
}
